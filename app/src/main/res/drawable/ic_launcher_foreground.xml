<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Flashlight Beam Flare -->
    <path
        android:pathData="M54,42 L26,20 L82,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="42"
                android:endX="54"
                android:endY="20"
                android:type="linear">
                <item android:color="#FFE57F" android:offset="0.0" />
                <item android:color="#44FFD54F" android:offset="0.7" />
                <item android:color="#00FFC107" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Radiating Light Rays -->
    <path
        android:strokeColor="#FFD54F"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M54,16 L54,11 M36,20 L31,16 M72,20 L77,16" />

    <!-- Flashlight Bezel Head -->
    <path
        android:fillColor="#FFC107"
        android:pathData="M43,44 L65,44 A2,2 0 0,1 67,46 L68,50 L40,50 L41,46 A2,2 0 0,1 43,44 Z" />

    <!-- Lens Glow Line -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M44,45 L64,45" />

    <!-- Flashlight Neck Cone -->
    <path
        android:fillColor="#ECEFF1"
        android:pathData="M41,50 L67,50 L63,60 L45,60 Z" />

    <!-- Flashlight Handle / Barrel -->
    <path
        android:fillColor="#CFD8DC"
        android:pathData="M45,60 L63,60 L63,82 A3,3 0 0,1 60,85 L48,85 A3,3 0 0,1 45,82 Z" />

    <!-- Handle Grip Grooves -->
    <path
        android:strokeColor="#90A4AE"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M47,68 L61,68 M47,73 L61,73 M47,78 L61,78" />

    <!-- Power Switch on Handle -->
    <path
        android:fillColor="#FF5722"
        android:pathData="M52,62 L56,62 A1,1 0 0,1 57,63 L57,66 A1,1 0 0,1 56,67 L52,67 A1,1 0 0,1 51,66 L51,63 A1,1 0 0,1 52,62 Z" />

</vector>

